}

model IncidentUpdate {
  id         String   @id @default(cuid())
  incidentId String
  title      String
  type       String // investigating, identified, monitoring, resolved, completed
  message    String   @db.Text
  createdAt  DateTime @default(now())

  incident Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)

  @@index([incidentId])
  @@map("incident_updates")
}

model Punishment {
  id            String   @id @default(cuid())
  userId        String? // Optional linked platform user ID
  discordId     String // Discord ID of the punished user
  username      String // Discord username of the punished user
  moderatorId   String // Discord ID of the moderator
  moderatorName String // Name of the moderator
  type          String // "WARN", "TIMEOUT", "BAN", etc.
  reason        String   @db.Text
  duration      String? // e.g. "5m"
  proofUrl      String?  @db.Text // URL of proof (image attachment, etc.)
