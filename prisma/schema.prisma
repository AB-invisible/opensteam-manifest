enum VerificationSessionStatus {
  PENDING
  OAUTH_COMPLETE
  COMPLETED
  EXPIRED
  FAILED
}

model DiscordVerificationSession {
  id                   String                    @id @default(cuid())
  discordId            String
  guildId              String
  status               VerificationSessionStatus @default(PENDING)
  sessionSecret        String
  expiresAt            DateTime
  oauthAccessToken     String?
  oauthRefreshToken    String?
  verifyIp             String?
  verifyCountry        String?
  verifyUserAgent      String?
  verifyFingerprint    String?
  verifyCanvasHash     String?
