# ---- Build Stage ----
FROM node:22-alpine AS builder

# Set working directory
WORKDIR /app

# Install dependencies required for sharp, Prisma, etc.
RUN apk add --no-cache libc6-compat openssl python3 make g++ bash

# Copy package management files
COPY package.json package-lock.json ./

# Install dependencies cleanly
RUN npm ci

# Copy the rest of the application files
COPY . .

# Generate Prisma Client
RUN npx prisma generate

# Provide dummy DB URL for Next.js static generation phase so Prisma doesn't throw initialization errors
ENV DATABASE_URL="postgresql://dummy:dummy@localhost:5432/dummy"

# Build Next.js application
RUN npm run build

# ---- Production Stage ----
FROM node:22-alpine AS runner

WORKDIR /app

# Install runtime dependencies for Prisma and external tools
RUN apk add --no-cache openssl bash curl

# Don't run as root for security (optional but recommended, however, bot-daemon might need specific perms, we'll keep it simple for now)
# RUN addgroup --system --gid 1001 nodejs && adduser --system --uid 1001 nextjs

# Copy essential files from builder
COPY --from=builder /app/package.json /app/package-lock.json ./
COPY --from=builder /app/next.config.js ./
COPY --from=builder /app/public ./public
COPY --from=builder /app/.next ./.next
COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/scripts ./scripts
COPY --from=builder /app/prisma ./prisma

# Environment variables
ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1
ENV PORT=3000

EXPOSE 3000

# Default command (Web Server). For the bot, we override this in docker-compose.yml
CMD ["npm", "run", "start"]
