{
  "name": "manifest-generator",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@10.9.4",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "bash scripts/setup-ollama.sh && node scripts/wait-for-db.js && node scripts/fix-enum.js && node scripts/migrate-deploy.js && node scripts/sync-forge-to-disk.js && node scripts/ensure-bot.js && node scripts/ensure-hosted-bots.js && next start",
    "start:windows": "node scripts/wait-for-db.js && node scripts/fix-enum.js && node scripts/migrate-deploy.js && node scripts/sync-forge-to-disk.js && node scripts/ensure-bot.js && node scripts/ensure-hosted-bots.js && next start",
    "lint": "next lint",
    "test": "vitest run",
    "prod": "npm run build && bash scripts/setup-ollama.sh && node scripts/wait-for-db.js && node scripts/fix-enum.js && node scripts/migrate-deploy.js && node scripts/sync-forge-to-disk.js && node scripts/ensure-bot.js && node scripts/ensure-hosted-bots.js && next start",
    "bot": "node scripts/bot-daemon.js",
    "start:cloud": "node scripts/start-cloud.js",
    "docker:cloud": "docker compose -f docker-compose.cloud.yml up -d --build",
    "docker:cloud:logs": "docker compose -f docker-compose.cloud.yml logs -f",
    "hosted-bots": "node scripts/ensure-hosted-bots.js",
    "sync-s3": "node scripts/sync-to-s3.js",
    "download-s3": "node scripts/download-from-s3.js",
    "sync-onlinefix": "node scripts/sync-onlinefix-s3.js",
    "transfer-account": "node scripts/transfer-discord-account.js",
    "render:env": "node scripts/generate-render-env.js",
    "render:setup": "node scripts/setup-render.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1008.0",
    "@aws-sdk/lib-storage": "^3.1008.0",
    "@aws-sdk/s3-request-presigner": "^3.1079.0",
    "@discord/embedded-app-sdk": "^2.5.0",
    "@discordjs/voice": "^0.19.2",
    "@hookform/resolvers": "^3.3.2",
    "@next/font": "14.0.4",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/api-logs": "^0.217.0",
    "@opentelemetry/exporter-logs-otlp-http": "^0.217.0",
    "@opentelemetry/resources": "^2.7.1",
    "@opentelemetry/sdk-logs": "^0.217.0",
    "@opentelemetry/sdk-node": "^0.217.0",
    "@opentelemetry/semantic-conventions": "^1.40.0",
    "@prisma/client": "5.7.0",
    "@radix-ui/react-dialog": "^1.0.5",
    "@radix-ui/react-dropdown-menu": "^2.0.6",
    "@radix-ui/react-label": "^2.0.2",
    "@radix-ui/react-select": "^2.0.0",
    "@radix-ui/react-separator": "^1.0.3",
    "@radix-ui/react-slot": "^1.0.2",
    "@radix-ui/react-switch": "^1.0.3",
    "@radix-ui/react-tabs": "^1.0.4",
    "@radix-ui/react-toast": "^1.1.5",
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "@types/uuid": "^9.0.7",
    "autoprefixer": "^10.4.16",
    "axios": "^1.6.2",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.0.0",
    "discord.js": "^14.25.1",
    "dotenv": "^17.3.1",
    "ffmpeg-static": "^5.3.0",
    "googleapis": "^171.4.0",
    "groq-sdk": "^1.2.0",
    "https-proxy-agent": "^9.1.0",
    "jszip": "^3.10.1",
    "libsodium-wrappers": "^0.8.4",
    "localtunnel": "^2.0.2",
    "lucide-react": "^0.294.0",
    "next": "^14.2.25",
    "next-auth": "^4.24.5",
    "nodemailer": "^7.0.13",
    "opusscript": "^0.0.8",
    "pdf-lib": "^1.17.1",
    "postcss": "^8.4.32",
    "prism-media": "^1.3.5",
    "prisma": "5.7.0",
    "react": "^18",
    "react-dom": "^18",
    "react-hook-form": "^7.48.2",
    "resend": "^6.12.3",
    "sharp": "^0.33.1",
    "standardwebhooks": "^1.0.0",
    "tailwind-merge": "^2.2.0",
    "tailwindcss": "^3.3.6",
    "typescript": "^5",
    "uuid": "^9.0.1",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/nodemailer": "^8.0.0",
    "eslint": "^8",
    "eslint-config-next": "^14.2.25",
    "vitest": "^3.2.6"
  }
}
