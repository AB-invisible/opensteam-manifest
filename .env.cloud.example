# Copy to .env on your cloud VM (Oracle / Fly / any Linux host).
# Database: use Neon free Postgres — https://neon.tech (no local Postgres needed).

DATABASE_URL="postgresql://USER:PASSWORD@ep-xxx.region.aws.neon.tech/neondb?sslmode=require"

NEXTAUTH_SECRET="generate-a-long-random-string"
NEXTAUTH_URL="https://opensteam.lol"
NEXT_PUBLIC_APP_URL="https://opensteam.lol"
AUTH_TRUST_HOST="true"
TRUSTED_PROXY="cloudflare"

# Bot talks to web over Docker network (do not change on compose deploy).
INTERNAL_APP_URL="http://web:3000"
MANIFEST_UPLOAD_BASE_URL="http://web:3000"

ADMIN_API_KEY="your-admin-api-key"
STEAM_API_KEY=""
DISCORD_CLIENT_ID=""
DISCORD_CLIENT_SECRET=""
DISCORD_GUILD_ID=""
DISCORD_BOT_TOKEN=""

RYUU_API_KEY=""
MORRENUS_API_KEY=""
DEPOTBOX_API_KEY=""

STORAGE_PATH="/data"

# Cloudflare named tunnel token (Zero Trust → Networks → Tunnels → Create).
TUNNEL_TOKEN=""

# Optional: S3/R2 for large manifest archives instead of VM disk only.
# AWS_S3_BUCKET_NAME=""
# AWS_ACCESS_KEY_ID=""
# AWS_SECRET_ACCESS_KEY=""
# AWS_ENDPOINT_URL=""
